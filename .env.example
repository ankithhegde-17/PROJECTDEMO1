# Optional Qwen reasoning layer. The dashboard starts with deterministic analytics if unset.
AI_ENABLED=true
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TIMEOUT_SECONDS=20

# Optional MongoDB Atlas persistence. If unset, falls back to local SQLite.
MONGODB_URI=
MONGODB_DB_NAME=hr_intelligence

